  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 58b647c5b2ec4184e9a07a561cdf0644, type: 3}
    m_FontSize: 43
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 44
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.6
  m_Text: 'Dear Delilah,


    Sky is closer in Poppy Town.

    Ambrosia for us.

    Vines
    nourish our thirst.

    An ethereal feast.


    My mind, quiet.

    Everyone,
    waiting.


    Mary


    Mary'
